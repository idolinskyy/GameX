# Копіює runtime Qt з офіційного інсталера в ${CMAKE_INSTALL_PREFIX}/${GAMEX_BUNDLE_LIBDIR}.
# Викликається з install(CODE). DESTDIR застосовується через ENV{DESTDIR}.
if(NOT DEFINED GAMEX_QT_PREFIX OR GAMEX_QT_PREFIX STREQUAL "")
  message(FATAL_ERROR "GAMEX_QT_PREFIX is empty")
endif()
if(NOT DEFINED GAMEX_BUNDLE_LIBDIR)
  set(GAMEX_BUNDLE_LIBDIR "lib/gamex")
endif()

set(_dst "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/${GAMEX_BUNDLE_LIBDIR}")
file(MAKE_DIRECTORY "${_dst}")
file(MAKE_DIRECTORY "${_dst}/plugins")

function(gamex_install_so_glob pattern)
  file(GLOB _files ${pattern})
  foreach(_src IN LISTS _files)
    get_filename_component(_name "${_src}" NAME)
    if(NOT _name MATCHES "\\.debug$" AND NOT _name MATCHES "\\.prl$" AND NOT _name MATCHES "\\.a$")
      file(COPY "${_src}" DESTINATION "${_dst}")
    endif()
  endforeach()
endfunction()

foreach(_mod Core Gui Widgets DBus OpenGL XcbQpa)
  gamex_install_so_glob("${GAMEX_QT_PREFIX}/lib/libQt6${_mod}.so*")
endforeach()
gamex_install_so_glob("${GAMEX_QT_PREFIX}/lib/libicuuc.so*")
gamex_install_so_glob("${GAMEX_QT_PREFIX}/lib/libicui18n.so*")
gamex_install_so_glob("${GAMEX_QT_PREFIX}/lib/libicudata.so*")

function(gamex_install_plugin_files subdir)
  set(_out "${_dst}/plugins/${subdir}")
  file(MAKE_DIRECTORY "${_out}")
  foreach(_name IN LISTS ARGN)
    set(_src "${GAMEX_QT_PREFIX}/plugins/${subdir}/${_name}")
    if(EXISTS "${_src}")
      file(COPY "${_src}" DESTINATION "${_out}")
    endif()
  endforeach()
endfunction()

function(gamex_install_plugin_dir subdir)
  set(_src_dir "${GAMEX_QT_PREFIX}/plugins/${subdir}")
  if(NOT EXISTS "${_src_dir}")
    return()
  endif()
  set(_out "${_dst}/plugins/${subdir}")
  file(MAKE_DIRECTORY "${_out}")
  file(GLOB _plugs "${_src_dir}/*.so")
  foreach(_src IN LISTS _plugs)
    file(COPY "${_src}" DESTINATION "${_out}")
  endforeach()
endfunction()

gamex_install_plugin_files(platforms libqxcb.so)
gamex_install_plugin_files(imageformats
  libqgif.so libqico.so libqjpeg.so libqpng.so libqsvg.so libqwebp.so)
gamex_install_plugin_dir(tls)
gamex_install_plugin_dir(xcbglintegrations)
gamex_install_plugin_dir(platforminputcontexts)
gamex_install_plugin_dir(platformthemes)
gamex_install_plugin_dir(iconengines)

file(WRITE "${_dst}/qt.conf" "[Paths]\nPrefix = .\nPlugins = plugins\nLibraries = .\n")
